{
    "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
    "type": "datasource",
    "name": "Asyntai AI Chatbot",
    "id": "asyntai-aichatbot-datasource",
    "metrics": true,
    "backend": false,
    "info": {
        "description": "See what your website chatbot is doing for the business: who it helped, what they kept asking, and how many became leads.",
        "author": {
            "name": "Asyntai",
            "url": "https://asyntai.com"
        },
        "keywords": [
            "chatbot",
            "ai",
            "support",
            "leads",
            "asyntai"
        ],
        "logos": {
            "small": "img/logo.png",
            "large": "img/logo.png"
        },
        "links": [
            {
                "name": "Website",
                "url": "https://asyntai.com"
            },
            {
                "name": "Documentation",
                "url": "https://asyntai.com/documentation/integrations/grafana/"
            },
            {
                "name": "Report an issue",
                "url": "https://github.com/asyntai/grafana-asyntai-datasource/issues"
            }
        ],
        "screenshots": [
            {
                "name": "Everything your chatbot did, on one dashboard",
                "path": "img/screenshot-overview.png"
            },
            {
                "name": "Where the questions come from",
                "path": "img/screenshot-where-from.png"
            },
            {
                "name": "Read any conversation without leaving Grafana",
                "path": "img/screenshot-conversation.png"
            }
        ],
        "version": "%VERSION%",
        "updated": "%TODAY%"
    },
    "includes": [
        {
            "type": "dashboard",
            "name": "Asyntai overview",
            "path": "dashboards/overview.json"
        }
    ],
    "routes": [
        {
            "path": "asyntai",
            "url": "https://asyntai.com",
            "headers": [
                {
                    "name": "Authorization",
                    "content": "Bearer {{ .SecureJsonData.apiKey }}"
                }
            ]
        }
    ],
    "dependencies": {
        "grafanaDependency": ">=12.3.0",
        "plugins": []
    }
}